{
    "family": "odoo-deploy-db",
    "runtimePlatform": {
        "cpuArchitecture": "ARM64",
        "operatingSystemFamily": "LINUX"
    },
    "volumes": [
        {
            "name": "db-data",
            "dockerVolumeConfiguration": {
                "scope": "shared",
                "autoprovision": true,
                "driver": "local"
            }
        }
    ],
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "taskRoleArn": "arn:aws:iam::662505429824:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::662505429824:role/ecsTaskExecutionRole",
    "placementConstraints": [],
    "enableFaultInjection": false,
    "containerDefinitions": [
        {
            "name": "db",
            "image": "postgres:18-alpine",
            "essential": true,
            "cpu": 256,
            "memory": 384,
            "memoryReservation": 128,
            "portMappings": [
                {
                    "name": "db-5432",
                    "containerPort": 5432,
                    "hostPort": 0,
                    "protocol": "tcp"
                }
            ],
            "mountPoints": [
                {
                    "sourceVolume": "db-data",
                    "containerPath": "/var/lib/postgresql",
                    "readOnly": false
                }
            ],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/odoo-deploy-db",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-southeast-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "pg_isready || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            },
            "systemControls": [],
            "environment": [
                {
                    "name": "POSTGRES_USER",
                    "value": "odoo"
                },
                {
                    "name": "POSTGRES_PASSWORD",
                    "value": ""
                },
                {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/17/docker"
                },
                {
                    "name": "POSTGRES_DB",
                    "value": "postgres"
                }
            ],
            "command": [],
            "dockerLabels": {}
        }
    ]
}